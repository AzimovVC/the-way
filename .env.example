# Ключи Supabase. Скопировать в .env.local — тот в .gitignore и остаётся на машине.
#
# Берутся в проекте на supabase.com: Project Settings → API Keys (Publishable key, `sb_publishable_…`)
# и Project Settings → Data API (Project URL).
#
# Publishable — бывший `anon public`. Он уезжает в собранный бандл, и это нормально: данные
# защищают политики RLS (supabase/migrations), а не тайна ключа. `sb_secret_…` (бывший
# `service_role`) в приложение не попадает никогда — он политики обходит.
#
# Без этих двух строк приложение работает ровно как раньше: дорога лежит в localStorage, вход и
# профили просто не предлагаются.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Ключ KLIPY для поиска гифок: partner.klipy.com → API Keys. Тестовый ключ — 100 запросов в час,
# для живых людей нужен продакшн-ключ (бесплатный, запрашивается там же). Без ключа шторка гифок
# говорит, что поиск выключен, — остальное приложение работает как раньше.
VITE_KLIPY_API_KEY=
