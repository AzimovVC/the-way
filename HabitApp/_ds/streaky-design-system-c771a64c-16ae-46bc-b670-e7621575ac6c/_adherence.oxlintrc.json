{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/habits/**",
              "components/navigation/**",
              "components/progress/**",
              "ui_kits/streaky-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Fredoka|Figtree|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Fredoka, Figtree, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArtSlot'] > JSXAttribute > JSXIdentifier[name!=/^(?:ratio|label|src|alt|tone|radius|style|key|ref|className|style|children)$/]",
        "message": "<ArtSlot> doesn't accept that prop. Declared props: ratio, label, src, alt, tone, radius, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArtSlot'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:sunken|brand)$/]",
        "message": "<ArtSlot> tone must be one of 'sunken' | 'brand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|solid|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, icon, solid, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:brand|success|info|danger|rest|neutral)$/]",
        "message": "<Badge> tone must be one of 'brand' | 'success' | 'info' | 'danger' | 'rest' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|size|variant|iconLeft|iconRight|fullWidth|disabled|loading|onClick|type|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, tone, size, variant, iconLeft, iconRight, fullWidth, disabled, loading, onClick, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|action|success|info|neutral)$/]",
        "message": "<Button> tone must be one of 'primary' | 'action' | 'success' | 'info' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|outline|ghost)$/]",
        "message": "<Button> variant must be one of 'solid' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|plinth|interactive|padding|onClick|style|key|ref|className|style|children)$/]",
